{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mojidata-map",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mojidata-map.ryusei.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
  },
}
