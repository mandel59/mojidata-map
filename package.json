{
  "name": "mojidata-map",
  "version": "0.1.0",
  "private": true,
  "description": "Unicode character explorer for desktop and web",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "data:generate": "python3 tools/build_unicode.py",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win zip --x64",
    "format": "prettier --write src desktop tools/*.mjs tests *.ts *.json",
    "format:check": "prettier --check src desktop tools/*.mjs tests *.ts *.json",
    "test:desktop": "node tools/smoke-desktop.mjs",
    "credits:generate": "node tools/build-credits.mjs",
    "prebuild": "node tools/patch-fontkit.mjs && npm run credits:generate",
    "predev": "node tools/patch-fontkit.mjs && npm run credits:generate",
    "postinstall": "node tools/patch-fontkit.mjs"
  },
  "build": {
    "appId": "org.mojidata.map",
    "productName": "Mojidata Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "buffer": "6.0.3",
    "fontkit": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
